{
  "name": "Fedora Multi-Language & Low-Level Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  
  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": [
        // C / C++ & Assembly
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "dan-c-underwood.arm",
        "13xforever.language-x86-64-assembly",

        // Go
        "golang.go",

        // Java
        "vscjava.vscode-java-pack",

        // Python
        "ms-python.python",
        "ms-python.vscode-pylance",

        // C# / .NET
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",

        // JavaScript / TypeScript
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",

        // Git & Productivity
        "eamodio.gitlens",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true
      }
    }
  },

  // Lifecycle hook running our modular setup script
  "postCreateCommand": "bash .devcontainer/setup.sh",

  // Common application ports exposed
  "forwardPorts": [3000, 5000, 8080],

  "mounts": [
    {
      "source": "codespace-bashhistory",
      "target": "/home/vscode/.bash_history",
      "type": "volume"
    }
  ]
}